# Copy this file to `.env` and fill in real values.

APP_ENV=local

DB_HOST=localhost
DB_NAME=organization
DB_USER=root
DB_PASS=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_FROM_NAME="Organization"

JWT_SECRET=change_this_to_a_long_random_secret
JWT_ISSUER=Your_Issuer
JWT_TTL_SECONDS=EXP_TIME

STRIPE_PUBLISH_KEY=ENTER_YOUR_STRIPE_PUBLISH_KEY
STRIPE_SECRET_KEY=ENTER_YOUR_STRIPE_SECRET_KEY

# Base URL used in links (optional)
APP_URL=http://localhost/phpLearning/Project
